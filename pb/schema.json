{
  "$comment": "Modelo de datos del sistema inmobiliario. Se aplica con: node scripts/pb-schema.mjs inmobiliaria pb/schema.json (desde la raíz de la fábrica). Aditivo: nunca borra campos existentes. Los permisos se declaran como INTENCION en `access` y los compila scripts/lib/access.mjs: `public` dice en voz alta lo que una regla vacia solo insinuaba. OJO: PocketBase >=0.23 no crea created/updated solo — todo sort por fecha exige declarar los campos autodate de abajo.",
  "collections": [
    {
      "name": "propietarios",
      "fields": [
        {
          "name": "nombre",
          "type": "text",
          "required": true
        },
        {
          "name": "telefono",
          "type": "text"
        },
        {
          "name": "email",
          "type": "email"
        },
        {
          "name": "notas",
          "type": "text"
        },
        {
          "name": "created",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": false
        },
        {
          "name": "updated",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": true
        }
      ],
      "access": {
        "list": "signed-in",
        "view": "signed-in",
        "create": "signed-in",
        "update": "signed-in",
        "delete": "signed-in"
      }
    },
    {
      "name": "propiedades",
      "fields": [
        {
          "name": "titulo",
          "type": "text",
          "required": true
        },
        {
          "name": "direccion",
          "type": "text"
        },
        {
          "name": "municipio",
          "type": "text"
        },
        {
          "name": "precio",
          "type": "number"
        },
        {
          "name": "habitaciones",
          "type": "number"
        },
        {
          "name": "banos",
          "type": "number"
        },
        {
          "name": "superficie",
          "type": "number"
        },
        {
          "name": "descripcion",
          "type": "text"
        },
        {
          "name": "estado",
          "type": "select",
          "maxSelect": 1,
          "values": [
            "borrador",
            "publicada",
            "reservada",
            "vendida"
          ]
        },
        {
          "name": "fotos",
          "type": "file",
          "maxSelect": 10,
          "maxSize": 5242880,
          "mimeTypes": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/svg+xml"
          ],
          "thumbs": [
            "600x400"
          ]
        },
        {
          "name": "propietario",
          "type": "relation",
          "collection": "propietarios",
          "maxSelect": 1
        },
        {
          "name": "created",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": false
        },
        {
          "name": "updated",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": true
        }
      ],
      "access": {
        "list": {
          "raw": "estado = \"publicada\" || @request.auth.id != \"\""
        },
        "view": {
          "raw": "estado = \"publicada\" || @request.auth.id != \"\""
        },
        "create": "signed-in",
        "update": "signed-in",
        "delete": "signed-in"
      }
    },
    {
      "name": "leads",
      "fields": [
        {
          "name": "nombre",
          "type": "text",
          "required": true
        },
        {
          "name": "telefono",
          "type": "text"
        },
        {
          "name": "email",
          "type": "email"
        },
        {
          "name": "mensaje",
          "type": "text"
        },
        {
          "name": "propiedad",
          "type": "relation",
          "collection": "propiedades",
          "maxSelect": 1
        },
        {
          "name": "etapa",
          "type": "select",
          "maxSelect": 1,
          "values": [
            "nuevo",
            "contactado",
            "visita",
            "oferta",
            "reservado",
            "vendido",
            "nutriendo"
          ]
        },
        {
          "name": "origen",
          "type": "text"
        },
        {
          "name": "criterios",
          "type": "text"
        },
        {
          "name": "ultimo_contacto",
          "type": "date"
        },
        {
          "name": "prioridad",
          "type": "number",
          "min": 1,
          "max": 5,
          "onlyInt": true
        },
        {
          "name": "created",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": false
        },
        {
          "name": "updated",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": true
        }
      ],
      "access": {
        "list": "signed-in",
        "view": "signed-in",
        "create": "public",
        "update": "signed-in",
        "delete": "signed-in"
      }
    },
    {
      "name": "actividades",
      "fields": [
        {
          "name": "lead",
          "type": "relation",
          "collection": "leads",
          "maxSelect": 1
        },
        {
          "name": "tipo",
          "type": "select",
          "maxSelect": 1,
          "values": [
            "nota",
            "llamada",
            "email",
            "whatsapp",
            "visita"
          ]
        },
        {
          "name": "nota",
          "type": "text"
        },
        {
          "name": "direccion",
          "type": "select",
          "maxSelect": 1,
          "values": [
            "saliente",
            "entrante"
          ]
        },
        {
          "name": "asunto",
          "type": "text"
        },
        {
          "name": "estado_envio",
          "type": "select",
          "maxSelect": 1,
          "values": [
            "registrado",
            "enviado",
            "entregado",
            "abierto",
            "click",
            "error",
            "simulado"
          ]
        },
        {
          "name": "mensaje_id",
          "type": "text"
        },
        {
          "name": "created",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": false
        },
        {
          "name": "updated",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": true
        }
      ],
      "access": {
        "list": "signed-in",
        "view": "signed-in",
        "create": "signed-in",
        "update": "signed-in",
        "delete": "signed-in"
      }
    },
    {
      "$comment": "CRM configuration: which modules are on, and which adapter each integration uses. One row per `key`. This format declares no indexes, so uniqueness is not expressible here — the CRM's data layer enforces it instead (read by filter key=\"...\", update if found, create if not). NEVER store secrets: any signed-in user can read this collection and the browser bundle is public, so credentials keep living in the chassis and this only records WHICH adapter is selected. `value` is versioned so a later migration is possible: modules.<id> -> {v, enabled}; integrations.<id> -> {v, adapter, config}. No hand-written created/updated: compileFields appends both autodate fields by itself.",
      "name": "settings",
      "fields": [
        {
          "name": "key",
          "type": "text",
          "required": true
        },
        {
          "name": "value",
          "type": "json"
        },
        {
          "name": "note",
          "type": "text"
        }
      ],
      "access": {
        "list": "signed-in",
        "view": "signed-in",
        "create": "signed-in",
        "update": "signed-in",
        "delete": "signed-in"
      }
    }
  ]
}
