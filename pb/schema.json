    {
      "$comment": "Outbound campaigns: one template sent to a segment of leads in daily batches. `segmento` is a JSON filter ({etapa[], consentimiento, origen[], idioma, canal_preferido, asignado}) evaluated by the jobs runner, `lote_diario` and `intervalo_min` throttle the sends, and `hora_desde`/`hora_hasta` (HH:MM, Europe/Madrid) bound the sending window. `informe` accumulates the delivery counts. Declared before `actividades` so `actividades.campana` resolves on pass 1.",
      "name": "campanas",
      "fields": [
        {
          "name": "nombre",
          "type": "text",
          "required": true
        },
        {
          "name": "plantilla",
          "type": "relation",
          "collection": "plantillas",
          "maxSelect": 1
        },
        {
          "name": "segmento",
          "type": "json"
        },
        {
          "name": "lote_diario",
          "type": "number",
          "min": 1,
          "onlyInt": true
        },
        {
          "name": "intervalo_min",
          "type": "number",
          "min": 0,
          "onlyInt": true
        },
        {
          "name": "hora_desde",
          "type": "text",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        {
          "name": "hora_hasta",
          "type": "text",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        {
          "name": "inicio",
          "type": "date"
        },
        {
          "name": "estado",
          "type": "select",
          "maxSelect": 1,
          "values": [
            "borrador",
            "programada",
            "en_curso",
            "pausada",
            "completada",
            "cancelada"
          ]
        },
        {
          "name": "ultimo_envio_en",
          "type": "date"
        },
        {
          "name": "informe",
          "type": "json"
        },
        {
          "name": "created",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": false
        },
        {
          "name": "updated",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": true
        }
      ],
      "access": {
        "list": "signed-in",
        "view": "signed-in",
        "create": "signed-in",
        "update": "signed-in",
        "delete": "signed-in"
      }
