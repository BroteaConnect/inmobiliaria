    {
      "$comment": "Message templates, one row per `clave` and channel. A template is written once in both app languages and sent through email or WhatsApp; `evento` names the lead lifecycle event that triggers it, `version` is bumped on every edit so `envios.plantilla_version` records what was actually sent. WhatsApp templates must be approved by Twilio before use: `content_sid` is the Content API id and `content_estado` stores Twilio's status verbatim. `clave` uniqueness is not expressible in this format — the CRM reads before it writes.",
      "name": "plantillas",
      "fields": [
        {
          "name": "clave",
          "type": "text",
          "required": true,
          "max": 80,
          "pattern": "^[a-z0-9_.]+$"
        },
        {
          "name": "nombre",
          "type": "text",
          "required": true
        },
        {
          "name": "canal",
          "type": "select",
          "maxSelect": 1,
          "values": [
            "email",
            "whatsapp"
          ]
        },
        {
          "name": "categoria",
          "type": "select",
          "maxSelect": 1,
          "values": [
            "utility",
            "marketing"
          ]
        },
        {
          "name": "asunto_es",
          "type": "text",
          "max": 200
        },
        {
          "name": "asunto_en",
          "type": "text",
          "max": 200
        },
        {
          "name": "cuerpo_es",
          "type": "text",
          "required": true
        },
        {
          "name": "cuerpo_en",
          "type": "text",
          "required": true
        },
        {
          "name": "variables",
          "type": "json"
        },
        {
          "name": "evento",
          "type": "text",
          "max": 80
        },
        {
          "name": "estado",
          "type": "select",
          "maxSelect": 1,
          "values": [
            "borrador",
            "aprobada",
            "retirada"
          ]
        },
        {
          "name": "version",
          "type": "number",
          "min": 1,
          "onlyInt": true
        },
        {
          "name": "content_sid",
          "type": "text",
          "max": 40
        },
        {
          "name": "content_estado",
          "type": "select",
          "maxSelect": 1,
          "values": [
            "unsubmitted",
            "received",
            "pending",
            "approved",
            "rejected",
            "paused",
            "disabled"
          ]
        },
        {
          "name": "content_motivo",
          "type": "text"
        },
        {
          "name": "created",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": false
        },
        {
          "name": "updated",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": true
        }
      ],
      "access": {
        "list": "signed-in",
        "view": "signed-in",
        "create": "signed-in",
        "update": "signed-in",
        "delete": "signed-in"
