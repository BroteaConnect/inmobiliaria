    {
      "$comment": "Property visits: a lead, a property and the agent who shows it, at a given time. `resultado` tracks the visit from scheduled to done (or not shown, cancelled, rescheduled) so the agenda job and the CRM calendar read one source. No cascadeDelete: a visit outlives the deletion of its lead as evidence of the work done.",
      "name": "visitas",
      "fields": [
        {
          "name": "lead",
          "type": "relation",
          "collection": "leads",
          "maxSelect": 1
        },
        {
          "name": "propiedad",
          "type": "relation",
          "collection": "propiedades",
          "maxSelect": 1
        },
        {
          "name": "agente",
          "type": "relation",
          "collection": "users",
          "maxSelect": 1
        },
        {
          "name": "cuando",
          "type": "date",
          "required": true
        },
        {
          "name": "resultado",
          "type": "select",
          "maxSelect": 1,
          "values": [
            "pendiente",
            "confirmada",
            "realizada",
            "no_show",
            "cancelada",
            "reprogramada"
          ]
        },
        {
          "name": "notas",
          "type": "text"
        },
        {
          "name": "created",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": false
        },
        {
          "name": "updated",
          "type": "autodate",
          "onCreate": true,
          "onUpdate": true
        }
      ],
      "access": {
        "list": "signed-in",
        "view": "signed-in",
        "create": "signed-in",
        "update": "signed-in",
        "delete": "signed-in"
      }
