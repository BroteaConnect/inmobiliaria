---
// LanguageSwitcher.astro — GENERATED by `brotea new` / `brotea i18n sync`
// from i18n/runtime/LanguageSwitcher.astro. Fix it in the factory, not here.
//
// Links to the SAME page in every shipped locale (so switching language never
// throws the visitor back to the home page). Styled only in theme tokens.
import { LOCALES, NATIVE, localePath, stripLocale, t } from '../lib/i18n';
interface Props { locale: string }
const { locale } = Astro.props;
const path = stripLocale(Astro.url.pathname);
---

<nav class="lang" aria-label={t(locale, 'nav.language')}>
  {LOCALES.map((code) => (
    <a
      href={localePath(code, path)}
      hreflang={code}
      lang={code}
      aria-current={code === locale ? 'true' : undefined}
    >{NATIVE[code]}</a>
  ))}
</nav>

<style>
  .lang {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .lang a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius);
    line-height: 1.6;
  }
  .lang a:hover {
    color: var(--text);
    background: var(--bg);
  }
  .lang a[aria-current] {
    color: var(--primary);
    font-weight: 600;
  }
</style>
