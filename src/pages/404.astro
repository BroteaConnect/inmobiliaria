---
// The page behind every address that is nobody's: a language that does not
// exist, a deeper path nobody wrote. Prerendered, so the server hands it out
// as a file; in the default language, because a URL with no route has no
// locale either, and the switcher is right there.
import Layout from '../layouts/Layout.astro';
import { DEFAULT_LOCALE, localePath, t } from '../lib/i18n';

const locale = DEFAULT_LOCALE;
---

<Layout locale={locale} title={t(locale, 'notFound.title')} back>
  <section class="missing">
    <h1>{t(locale, 'notFound.title')}</h1>
    <p>{t(locale, 'notFound.text')}</p>
    <a class="button" href={localePath(locale, '/')}>{t(locale, 'nav.catalog')}</a>
  </section>
</Layout>

<style>
  .missing { max-width: 52ch; display: grid; gap: var(--space-3); justify-items: start; padding: var(--space-6) 0; }
  .missing h1 { font-size: var(--text-display-lg); margin: 0; }
  .missing p { color: var(--muted); margin: 0; }
</style>
