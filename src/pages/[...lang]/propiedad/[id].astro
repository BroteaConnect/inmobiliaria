---
// One property, one address: /propiedad/<id> and /en/propiedad/<id>.
//
// Rendered per request, not at build time: the CRM publishes listings every
// day and a route baked into the image would 404 each new one until somebody
// redeployed. Everything a preview or a crawler needs is in the HTML itself,
// because neither of them runs JavaScript.
import Layout from '../../../layouts/Layout.astro';
import Gallery from '../../../components/Gallery.astro';
import LeadForm from '../../../components/LeadForm.astro';
import WhatsAppDoor from '../../../components/WhatsAppDoor.astro';
import { DEFAULT_LOCALE, LOCALES, intlOf, localeOf, localePath, t, unknownLocale } from '../../../lib/i18n';
import {
  DEFAULT_CURRENCY, noteOf, descriptionIsNote, photoUrl, photos, metaOf, paragraphsOf,
  priceOf, realPrice, summaryOf,
} from '../../../lib/property';
import { publishedProperty } from '../../../lib/property.server';

export const prerender = false;

// `[...lang]` answers any prefix on a server route: a language that does not
// exist, or a deeper path nobody wrote, is a 404 and not a Spanish page at a
// made-up address. Rendered inline with the status set, never as an empty
// Response: Astro reroutes a bodiless 404 by fetching /404.html from the
// request's own origin, which a container cannot always reach.
const badLocale = unknownLocale(Astro);
const locale = badLocale ? DEFAULT_LOCALE : localeOf(Astro);
const id = String(Astro.params.id ?? '');
const lookup = badLocale ? 'missing' : await publishedProperty(id);
const p = typeof lookup === 'string' ? null : lookup;

// A draft, a reserved, a sold or an unknown id is a 404 with a page a person
// can use; a database that did not answer is a 503, so nobody caches "gone"
// for a listing that is merely unreachable.
if (!p) Astro.response.status = lookup === 'error' ? 503 : 404;
Astro.response.headers.set('Cache-Control', p ? 'public, max-age=60, stale-while-revalidate=300' : 'no-store');

const abs = (href: string) => (Astro.site ? new URL(href, Astro.site).href : href);
const ogLocale = (l: string) => intlOf(l).replace('-', '_');
const path = `/propiedad/${id}`;
const url = abs(localePath(locale, path));
const title = (p?.titulo ?? '').trim();
const summary = p ? summaryOf(p) || t(locale, 'page.description') : '';
const images = p ? photos(p).map((_, i) => photoUrl(p, i)) : [];
const image = images[0] || abs('/og-fallback.png');
const price = p ? realPrice(p) : 0;
const meta = p ? metaOf(locale, p) : '';
const note = p ? noteOf(p) : '';
const paragraphs = p && !descriptionIsNote(p) ? paragraphsOf(p) : [];
// PocketBase writes "2026-07-30 16:44:15.676Z", which V8 will not parse;
// schema.org reads ISO 8601, so the space becomes the T it stands for.
const createdAt = Date.parse((p?.created ?? '').replace(' ', 'T'));
const datePosted = Number.isNaN(createdAt) ? '' : new Date(createdAt).toISOString();

const ld = p && {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: title,
  description: summary,
  url,
  image: images.length ? images : [image],
  inLanguage: intlOf(locale),
  ...(datePosted ? { datePosted: datePosted } : {}),
  ...(price ? { offers: { '@type': 'Offer', price: price, priceCurrency: DEFAULT_CURRENCY, url } } : {}),
  ...(p.municipio ? { address: { '@type': 'PostalAddress', addressLocality: p.municipio } } : {}),
  ...(p.habitaciones && p.habitaciones > 0 ? { numberOfRooms: p.habitaciones } : {}),
  ...(p.superficie && p.superficie > 0
    ? { floorSize: { '@type': 'QuantitativeValue', value: p.superficie, unitCode: 'MTK' } }
    : {}),
};
// `<` escaped so agent input can never close the script element.
const ldJson = ld ? JSON.stringify(ld).replace(/</g, '\\u003c') : '';
---

{p ? (
  <Layout locale={locale} title={title} description={summary} back>
    <Fragment slot="head">
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content={t(locale, 'site.name')} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={summary} />
      <meta property="og:image" content={image} />
      <meta property="og:url" content={url} />
      <meta property="og:locale" content={ogLocale(locale)} />
      {LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={ogLocale(l)} />
      ))}
      <meta name="twitter:card" content="summary_large_image" />
      <script type="application/ld+json" set:html={ldJson} />
    </Fragment>

    <article class="ficha" data-propiedad={id}>
      <a class="volver" href={localePath(locale, '/')}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M12 5l-7 7 7 7"/></svg>
        <span>{t(locale, 'nav.catalog')}</span>
      </a>

      <div class="ficha-cuerpo">
        <Gallery locale={locale} p={p} />

        <header class="ficha-cabecera">
          {p.municipio && <p class="eyebrow">{p.municipio}</p>}
          <h1>{title}</h1>
          {note && <p class="apunte">{note}</p>}
          {meta && <p class="meta data">{meta}</p>}
          <p class="precio data" data-precio={price || undefined}>{priceOf(locale, p)}</p>
        </header>

        {paragraphs.length > 0 && (
          <div class="descripcion">
            {paragraphs.map((s) => <p>{s}</p>)}
          </div>
        )}
      </div>

      <aside class="puertas" aria-label={t(locale, 'form.title')}>
        <LeadForm locale={locale} propertyId={id} title={title} />
        <WhatsAppDoor class="wa-ficha" label={t(locale, 'wa.preguntar')} message={t(locale, 'wa.mensajePropiedad', { propiedad: title })} />
      </aside>
    </article>
  </Layout>
) : (
  <Layout locale={locale} title={t(locale, 'prop.notFound.title')} back>
    <section class="missing">
      <h1>{t(locale, 'prop.notFound.title')}</h1>
      <p>{t(locale, lookup === 'error' ? 'prop.error.text' : 'prop.notFound.text')}</p>
      <a class="button" href={localePath(locale, '/')}>{t(locale, 'nav.catalog')}</a>
    </section>
  </Layout>
)}

<script>
  import { fmtMoney, localeFromPath } from '../../../lib/i18n';
  import { loadBusiness, currencyOf } from '../../../lib/negocio';

  // The price was written in the default currency on the server; if the
  // owner set another one in the CRM it is rewritten here, once, in place.
  const price = document.querySelector<HTMLElement>('.ficha .precio[data-precio]');
  if (price) {
    loadBusiness().then((d) => {
      const moneda = currencyOf(d);
      const n = Number(price.dataset.precio);
      if (moneda && n > 0) price.textContent = fmtMoney(localeFromPath(location.pathname), n, moneda);
    });
  }
</script>

<style>
  .ficha { display: grid; gap: var(--space-5); }
  .volver {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: 600;
    text-decoration: none;
    color: var(--primary);
    justify-self: start;
  }
  .volver:hover span { text-decoration: underline; text-underline-offset: 3px; }
  .ficha-cuerpo { display: grid; gap: var(--space-5); min-width: 0; }
  .ficha-cuerpo > :global(*) { min-width: 0; }
  .ficha-cabecera { display: grid; gap: var(--space-2); }
  .ficha-cabecera h1 {
    font-size: var(--text-display-lg);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.15;
    margin: 0;
  }
  .ficha-cabecera .apunte { margin: var(--space-2) 0; }
  .meta { color: var(--muted); font-size: var(--text-data); font-weight: 500; letter-spacing: 0.01em; margin: 0; }
  /* Brass only on data: the price is a numeral, never a background or a button. */
  .precio { font-family: var(--font-sans); font-weight: 700; font-size: var(--text-data-lg); margin: 0; color: var(--accent); }
  .descripcion { max-width: 62ch; }
  .descripcion p { line-height: 1.6; margin: 0 0 var(--space-3); }
  .puertas { display: grid; gap: var(--space-4); align-content: start; }
  /* The secondary door sits beside the form, on the primary colour with the
     glyph carrying the recognition; it is present only when a number is. */
  .puertas :global(.wa-ficha) { justify-self: start; }
  /* One column at every width: the site's container is a 680px notebook
     page, and two columns inside it would give the home 328px. */
  .missing { max-width: 52ch; display: grid; gap: var(--space-3); justify-items: start; padding: var(--space-6) 0; }
  .missing h1 { font-size: var(--text-display-lg); margin: 0; }
  .missing p { color: var(--muted); margin: 0; }
</style>
