---
import Layout from '../../layouts/Layout.astro';
import { localePaths, t } from '../../lib/i18n';

// One file, every language: / (es) and /en/ come from src/locales/config.json.
export const getStaticPaths = localePaths;
const { locale } = Astro.props;

// Rooms chips: "n or more". The first control named `hab` in DOM order is the
// lowest value, so a script that picks "the rooms control" lands on 1.
const ROOMS = [1, 2, 3, 4];
---

<Layout locale={locale}>
  <section class="hero">
    <h1>{t(locale, 'hero.title')}</h1>
    <p class="lede">{t(locale, 'hero.lede')}</p>
    <div class="hero-filete" aria-hidden="true"></div>
  </section>

  <!-- The filters are a plain GET form so the URL is the state: a filtered
       view is a link an agent can send. The script keeps the address in sync
       with replaceState and never lets the form navigate; without JavaScript
       the same form submits to the same page, and the script reads the URL. -->
  <form data-filters class="filtros" method="get" action="" aria-label={t(locale, 'filters.title')}>
    <fieldset class="filtros-grupo">
      <legend>{t(locale, 'filters.town')}</legend>
      <div class="chips" data-town-chips>
        <label class="chip">
          <input type="radio" name="municipio" value="" checked />
          <span>{t(locale, 'filters.townAny')}</span>
        </label>
      </div>
    </fieldset>
    <div class="filtros-precio">
      <label>
        {t(locale, 'filters.min')}
        <input type="number" name="min" inputmode="numeric" min="0" />
      </label>
      <label>
        {t(locale, 'filters.max')}
        <input type="number" name="max" inputmode="numeric" min="0" />
      </label>
    </div>
    <fieldset class="filtros-grupo">
      <legend>{t(locale, 'filters.rooms')}</legend>
      <div class="chips">
        {ROOMS.map((n) => (
          <label class="chip">
            <input type="radio" name="hab" value={n} />
            <span>{t(locale, 'filters.roomsMin', { n })}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <div class="filtros-pie">
      <p class="filtros-cuenta data" role="status" data-filters-count></p>
      <button type="button" class="filtros-quitar" data-filters-reset>{t(locale, 'filters.reset')}</button>
    </div>
  </form>
  <p class="filtros-vacio" data-filters-empty hidden>{t(locale, 'filters.empty')}</p>

  <div id="catalogo" class="catalogo" aria-live="polite">
    <p class="cargando">{t(locale, 'catalog.loading')}</p>
  </div>

  <script>
    import { listAll, pbUrl } from '../../lib/pb';
    import { localeFromPath, localePath, t } from '../../lib/i18n';
    import { loadBusiness, currencyOf } from '../../lib/negocio';
    import { DEFAULT_CURRENCY, noteOf, photoUrl, photos, metaOf, priceOf, realPrice, type Property } from '../../lib/property';

    // Astro bundles this script ONCE for every generated route, so the locale
    // cannot be compiled in: it is resolved from the URL at runtime — the same
    // source the pages were generated from (/ → es, /en/ → en).
    const locale = localeFromPath(location.pathname);
    const _ = (key: string, vars?: Record<string, string | number>) => t(locale, key, vars);

    // The panel used to live at `?p=<id>`; those links are already out there
    // in chats and keep resolving, now to the property's own address.
    const compartida = new URLSearchParams(location.search).get('p');
    if (compartida) location.replace(localePath(locale, `/propiedad/${encodeURIComponent(compartida)}`));

    // La moneda es un dato del negocio, no una constante del código: una
    // agencia que vende en dirhams y otra que vende en euros usan el mismo
    // sitio. Sale de `settings` (negocio.moneda) y AED es lo que había, así
    // que es lo que queda mientras nadie configure otra cosa. Intl decide el
    // formato por idioma ("1.234.567 AED" en es, "AED 1,234,567" en en).
    let moneda = DEFAULT_CURRENCY;

    const cat = document.getElementById('catalogo')!;
    const form = document.querySelector<HTMLFormElement>('form[data-filters]')!;
    const townChips = form.querySelector<HTMLElement>('[data-town-chips]')!;
    const countLine = form.querySelector<HTMLElement>('[data-filters-count]')!;
    const emptyLine = document.querySelector<HTMLElement>('[data-filters-empty]')!;
    let props: Property[] = [];

    // Placeholder sin foto: silueta de casa en SVG (sin emojis).
    const casaSvg = '<svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9.5 21v-6h5v6"/></svg>';
    // Everything from the database is agent input: escaped before it meets markup.
    const esc = (s: unknown) => String(s ?? '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    // ---- Filters: the URL is the state, the list in memory is the data ----
    //
    // `?municipio=&min=&max=&hab=` are read on load and rewritten on every
    // change with replaceState, so nothing reloads and nothing is fetched
    // again: the cards are already on the page and only get shown or hidden.
    interface Filters { town: string; min: number | null; max: number | null; rooms: number | null }

    const fold = (s: string) => s.trim().toLocaleLowerCase();
    // A price bound: a positive number, or nothing. Zero is nothing too: a
    // keyboard user who taps ArrowDown in an empty box gets 0, and "at most
    // nothing" would empty the catalogue instead of leaving it alone.
    const bound = (v: string | null | undefined): number | null => {
      if (v == null || v.trim() === '') return null;
      const n = Number(v);
      return Number.isFinite(n) && n > 0 ? n : null;
    };
    // Rooms: a whole number of at least one, or nothing ("any").
    const roomsOf = (v: string | null | undefined): number | null => {
      const n = Math.floor(Number(v));
      return v != null && v.trim() !== '' && Number.isFinite(n) && n >= 1 ? n : null;
    };

    function readFilters(): Filters {
      const q = new URLSearchParams(location.search);
      return { town: (q.get('municipio') ?? '').trim(), min: bound(q.get('min')), max: bound(q.get('max')), rooms: roomsOf(q.get('hab')) };
    }

    function filtersFromForm(): Filters {
      const d = new FormData(form);
      const s = (k: string) => { const v = d.get(k); return typeof v === 'string' ? v : ''; };
      return { town: s('municipio').trim(), min: bound(s('min')), max: bound(s('max')), rooms: roomsOf(s('hab')) };
    }

    // Empty params are dropped so a clean view is a clean address; the locale
    // prefix and the hash are untouched because only `search` is rewritten.
    function writeUrl(f: Filters) {
      const q = new URLSearchParams();
      if (f.town) q.set('municipio', f.town);
      if (f.min !== null) q.set('min', String(f.min));
      if (f.max !== null) q.set('max', String(f.max));
      if (f.rooms !== null) q.set('hab', String(f.rooms));
      const qs = q.toString();
      history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : '') + location.hash);
    }

    // The count is a live region: cards move on every keystroke, the sentence
    // is read once the typing settles. Milliseconds; not CSS motion.
    const COUNT_SETTLE = 300;
    let countTimer: ReturnType<typeof setTimeout> | undefined;
    function announce(total: number, shown: number, now: boolean) {
      clearTimeout(countTimer);
      const write = () => { countLine.textContent = total ? _('filters.count', { count: shown }) : ''; };
      if (now) write(); else countTimer = setTimeout(write, COUNT_SETTLE);
    }

    // A zero price is not a price (Design Read, tell 10): under any bound it
    // hides, because nobody can say whether "on request" is within budget.
    // `now` writes the count in the same task (first paint); a change from a
    // control lets it settle.
    function applyFilters(f: Filters, now = false) {
      const cards = cat.querySelectorAll<HTMLElement>('[data-card]');
      let shown = 0;
      cards.forEach((c) => {
        const town = c.dataset.town ?? '';
        const price = Number(c.dataset.price) || 0;
        const rooms = Number(c.dataset.rooms) || 0;
        const ok = (!f.town || town === f.town || fold(town) === fold(f.town))
          && (f.rooms === null || rooms >= f.rooms)
          && (f.min === null || (price > 0 && price >= f.min))
          && (f.max === null || (price > 0 && price <= f.max));
        c.hidden = !ok;
        if (ok) shown += 1;
      });
      emptyLine.hidden = !(cards.length && shown === 0);
      announce(cards.length, shown, now);
    }

    // One chip per distinct town, built once from the list (render() runs
    // again when the currency arrives, and the chips must not double up).
    // Created here, not in the HTML: the towns are data the catalogue holds.
    function buildTownChips() {
      if (townChips.querySelectorAll('input').length > 1) return;
      const seen = new Set<string>();
      const towns: string[] = [];
      for (const p of props) {
        const town = (p.municipio ?? '').trim();
        if (!town || seen.has(fold(town))) continue;
        seen.add(fold(town));
        towns.push(town);
      }
      towns.sort((a, b) => a.localeCompare(b, locale));
      for (const town of towns) {
        const label = document.createElement('label');
        label.className = 'chip';
        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'municipio';
        input.value = town;
        const text = document.createElement('span');
        text.textContent = town;
        label.append(input, text);
        townChips.append(label);
      }
    }

    // The controls show what the URL says, and the URL says only what a
    // control can show: a town that matches no chip and a rooms value with no
    // chip fall away, so the address, the form and the cards agree from the
    // first paint on (the form, not the URL, is read at the next change).
    // `.checked`, never `defaultChecked`, so form.reset() still returns to
    // "any town, any rooms, no bounds". Returns the reconciled state.
    function syncControls(f: Filters): Filters {
      const towns = form.querySelectorAll<HTMLInputElement>('input[name="municipio"]');
      let town = '';
      towns.forEach((r) => {
        const on = r.value !== '' && !town && (r.value === f.town || fold(r.value) === fold(f.town));
        r.checked = on;
        if (on) town = r.value;
      });
      if (!town && towns[0]) towns[0].checked = true;
      let rooms: number | null = null;
      form.querySelectorAll<HTMLInputElement>('input[name="hab"]').forEach((r) => {
        r.checked = Number(r.value) === f.rooms;
        if (r.checked) rooms = f.rooms;
      });
      (form.elements.namedItem('min') as HTMLInputElement).value = f.min === null ? '' : String(f.min);
      (form.elements.namedItem('max') as HTMLInputElement).value = f.max === null ? '' : String(f.max);
      return { town, min: f.min, max: f.max, rooms };
    }

    const onChange = () => { const f = filtersFromForm(); writeUrl(f); applyFilters(f); };
    form.addEventListener('input', onChange);
    form.addEventListener('change', onChange);
    // Enter in a number input would submit the GET and reload the page.
    form.addEventListener('submit', (e) => e.preventDefault());
    form.querySelector('[data-filters-reset]')!.addEventListener('click', () => { form.reset(); onChange(); });

    function render() {
      form.hidden = !props.length;
      if (!props.length) {
        cat.innerHTML = `<p class="cargando">${_('catalog.empty')}</p>`;
        return;
      }
      cat.innerHTML = props.map((p, i) => {
        // The first photo is the one the page is judged on, so it is asked
        // for at high priority and never deferred to a layout pass. The rest
        // stay lazy — which does NOT delay the ones already on screen, only
        // the ones below it, and how many are on screen depends on a grid
        // that has not been laid out at the moment this string is built.
        const apunte = noteOf(p);
        const meta = metaOf(locale, p);
        const foto = photoUrl(p, 0, true);
        // data-town carries the raw value: it is the filter key, matched as
        // the database wrote it, not as the eyebrow displays it.
        return `
        <a class="card" href="${esc(localePath(locale, `/propiedad/${p.id}`))}" data-card data-id="${esc(p.id)}"
           data-town="${esc(p.municipio ?? '')}" data-price="${realPrice(p)}" data-rooms="${Number(p.habitaciones) || 0}">
          ${foto ? `<img src="${esc(foto)}" alt="${esc(p.titulo)}" width="600" height="400" ${i === 0 ? 'loading="eager" fetchpriority="high"' : 'loading="lazy"'} />` : `<div class="sinfoto">${casaSvg}</div>`}
          ${photos(p).length > 1 ? `<span class="fotos-badge data">${_('card.photos', { count: photos(p).length })}</span>` : ''}
          <div class="card-body">
            ${p.municipio ? `<p class="eyebrow">${esc(p.municipio)}</p>` : ''}
            <h2>${esc(p.titulo)}</h2>
            ${apunte ? `<p class="apunte">${esc(apunte)}</p>` : ''}
            ${meta ? `<p class="meta data">${esc(meta)}</p>` : ''}
            <p class="precio data">${esc(priceOf(locale, p, moneda))}</p>
            <span class="ver">${_('card.cta')}</span>
          </div>
        </a>`;
      }).join('');
      // Same task as the cards: the first frame that has them is already
      // filtered, so a shared link never flashes the whole catalogue first.
      buildTownChips();
      const asked = readFilters();
      const f = syncControls(asked);
      if (JSON.stringify(f) !== JSON.stringify(asked)) writeUrl(f);
      applyFilters(f, true);
    }

    if (pbUrl() && !compartida) {
      listAll<Property>('propiedades', { filter: 'estado="publicada"', sort: '-created' })
        .then((r) => { props = r; render(); })
        .catch(() => { form.hidden = true; cat.innerHTML = `<p class="cargando">${_('catalog.error')}</p>`; });

      // Los ajustes pueden llegar después del catálogo: se repintan los
      // precios ya escritos.
      loadBusiness().then((d) => {
        const cod = currencyOf(d);
        if (cod && cod !== moneda) {
          moneda = cod;
          if (props.length) render();
        }
      });
    }
  </script>

  <!-- El catálogo se genera desde JS: estilos globales a propósito
       (los estilos scoped de Astro no alcanzan nodos creados en runtime). -->
  <style is:global>
    /* The hero is prose: it keeps the reading width even though the page
       around it is now as wide as the screen. A headline set across 1180px
       is a headline nobody finishes. */
    .hero { max-width: var(--measure); }
    .hero h1 { font-size: var(--text-display-xl); font-weight: 800; letter-spacing: -0.02em;
               line-height: 1.05; margin: 0 0 var(--space-3); }
    .hero .lede { color: var(--muted); font-size: var(--text-body-lg); line-height: 1.55;
                  max-width: 52ch; margin: 0; }
    /* Filete Latón: eco del apunte de visita bajo el lede (firma, solo aquí). */
    .hero-filete { position: relative; width: min(220px, 55%); height: 2px;
                   background: var(--accent); margin: var(--space-5) 0 0; }
    .hero-filete::after { content: ''; position: absolute; right: -10px; top: -2px;
                          width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

    /* Filters: one row of groups on a laptop, stacked on a phone; the flex
       wrap decides, nothing else. The town chips are created by the script,
       which is why every rule here is global. Chips are the same control the
       lead form's franjas are: a real radio underneath (keyboard, focus and
       screen readers need it), a 44px surface on top. */
    .filtros { display: flex; flex-wrap: wrap; align-items: flex-start;
               gap: var(--space-4) var(--space-6); margin-top: var(--space-6); }
    .filtros[hidden] { display: none; }
    .filtros-grupo { border: 0; padding: 0; margin: 0; min-width: 0; }
    .filtros legend, .filtros-precio label { padding: 0; margin: 0 0 var(--space-2);
                                             font-weight: 600; font-size: var(--text-data); }
    .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .chip { position: relative; display: inline-flex; }
    .chip input { position: absolute; opacity: 0; width: 0; height: 0; margin: 0; }
    .chip span { display: inline-flex; align-items: center; min-height: 44px;
                 padding: 0 var(--space-4); border: 1px solid var(--border);
                 border-radius: var(--radius); background: var(--surface); color: var(--text);
                 font-weight: 500; font-size: var(--text-data); cursor: pointer;
                 transition-property: background-color, border-color, color, scale;
                 transition-duration: var(--duration-press);
                 transition-timing-function: var(--ease-out); }
    .chip:hover span { border-color: var(--primary); }
    .chip:active span { scale: var(--press-scale); }
    .chip input:checked + span { background: var(--primary); color: var(--primary-contrast);
                                 border-color: var(--primary); }
    .chip input:focus-visible + span { outline: 2px solid var(--primary); outline-offset: 2px; }
    .filtros-precio { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
                      gap: var(--space-3); flex: 0 1 22rem; }
    .filtros-precio label { display: flex; flex-direction: column; gap: var(--space-1); margin: 0; }
    .filtros-precio input { min-height: 44px; padding: var(--space-2) var(--space-3);
                            border: 1px solid var(--border); border-radius: var(--radius);
                            background: var(--surface); color: var(--text); font: inherit;
                            font-variant-numeric: tabular-nums; width: 100%;
                            transition-property: border-color;
                            transition-duration: var(--duration-press);
                            transition-timing-function: var(--ease-out); }
    .filtros-precio input::placeholder { color: var(--muted); }
    .filtros-precio input:focus-visible { border-color: var(--primary); outline-offset: 1px; }
    /* The count and the clear control share the last line, whole width. */
    .filtros-pie { flex-basis: 100%; display: flex; flex-wrap: wrap; align-items: center;
                   justify-content: space-between; gap: var(--space-3); }
    .filtros-cuenta { margin: 0; color: var(--muted); font-size: var(--text-data); }
    .filtros-quitar { min-height: 44px; padding: 0 var(--space-4); border: 1px solid var(--border);
                      border-radius: var(--radius); background: transparent; color: var(--primary);
                      font: inherit; font-weight: 600; cursor: pointer; }
    .filtros-quitar:hover { border-color: var(--primary); }
    .filtros-vacio { color: var(--muted); max-width: 52ch; margin: var(--space-4) 0 0; }
    .filtros-vacio[hidden] { display: none; }

    /* Three across on a laptop, two on a tablet, one on a phone — the shell
       decides, the grid just fills it. 300px keeps a card wide enough for a
       3:2 photo to be worth looking at instead of four thin slices. */
    .catalogo { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
                gap: var(--space-5); margin-top: var(--space-6); }
    .cargando { color: var(--muted); max-width: 52ch; }
    .card { position: relative; background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius-lg); box-shadow: var(--shadow); overflow: hidden;
            display: flex; flex-direction: column; color: inherit; text-decoration: none;
            transition-property: transform, box-shadow;
            transition-duration: var(--duration-fast);
            transition-timing-function: var(--ease-out); }
    /* Explicit: `display: flex` above beats the UA [hidden] rule. */
    .card[hidden] { display: none; }
    .card:hover { transform: translateY(-3px);
                  box-shadow: var(--shadow), 0 12px 28px color-mix(in srgb, var(--text) 12%, transparent); }
    .card:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
    .card img { width: 100%; aspect-ratio: 3/2; object-fit: cover; display: block; }
    .sinfoto { aspect-ratio: 3/2; display: grid; place-items: center;
               background: var(--bg); color: var(--muted); }
    .card-body { padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2); }
    .card h2 { font-size: var(--text-title); font-weight: 600; letter-spacing: -0.01em; margin: 0; }
    .card .apunte { margin: var(--space-1) 0; }
    .meta { color: var(--muted); font-size: var(--text-data); font-weight: 500;
            letter-spacing: .01em; margin: 0; }
    /* Latón solo en datos: el precio es numeral, nunca fondo ni botón. */
    .precio { font-family: var(--font-sans); font-weight: 700; font-size: var(--text-data-lg);
              margin: 0; color: var(--accent); }
    /* The card is the link; this is its visible handle, not a second target. */
    .ver { align-self: start; display: inline-flex; align-items: center;
           background: var(--primary); color: var(--primary-contrast);
           border-radius: var(--radius); padding: .5rem 1.2rem;
           font-weight: 600; min-height: 44px;
           transition-property: filter, transform, box-shadow; transition-duration: var(--duration-press); transition-timing-function: var(--ease-out); }
    .card:hover .ver { filter: brightness(1.06); box-shadow: var(--shadow); }
    .card:active .ver { transform: translateY(1px); filter: brightness(.97); }
    /* Overlay chrome on a photograph: the ink at 72% over the picture, the
       surface colour for the figure, as the gallery arrows do it. */
    .fotos-badge { position: absolute; top: var(--space-2); right: var(--space-2);
                   background: color-mix(in srgb, var(--text) 72%, transparent); color: var(--surface);
                   border-radius: var(--radius);
                   padding: .2rem .55rem; font-size: .8rem; font-weight: 500;
                   letter-spacing: .01em; line-height: 1.4; pointer-events: none; }
  </style>
</Layout>
